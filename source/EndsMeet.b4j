#Region Macros
#Macro: Title, Class Templates, ide://run?File=%PROJECT%\create_excluded.bat&Args=..\CorsFilter.bas&Args=..\HttpsFilter.bas
#Macro: Title, Update Manifest, ide://run?File=%ADDITIONAL%\..\B4X\manifest-writer.jar&Args=%PROJECT%&Args=%PROJECT%&Args=Version&Args=4.03&Args=B4J.DependsOn&Args=JavaObject,jServer&Args=CustomClassTemplates&Args=Server+Filter+(Cors)|CorsFilter,Server+Filter+(Https)|HttpsFilter
#Macro: Title, Create B4xLib, ide://run?File=%JAVABIN%\jar.exe&WorkingDirectory=..&Args=-cMf&Args=..\release\%PROJECT_NAME%.b4xlib&Args=EndsMeet.bas&Args=*Settings.bas&Args=*.b4x_excluded&Args=manifest.txt&Args=..\LICENSE
#Macro: Title, Copy to AddLibs, ide://run?File=%COMSPEC%&Args=/c&Args=copy&Args=%PROJECT%\..\release\*.b4xlib&Args=%ADDITIONAL%
#Macro: Title, Release Folder, ide://run?File=%WINDIR%\SysWOW64\explorer.exe&Args=%PROJECT%\..\release
#End Region
Sub Process_Globals
	Public App As EndsMeet
	Public count As Int
	Private Const VERSION As String = "4.03"
End Sub

' <link>Open in browser|http://127.0.0.1:8080</link>
Sub AppStart (Args() As String)
	App.Initialize
	App.LoadConfig
	App.LoadDotEnv
	'App.LogEnabled = True
	'App.HidePort = True
	
	App.Get("", "Index")
	App.Post("/modal", "Index")
	App.Route("/api/*", "Index", Array("Get", "Put", "GET"))
	For Each rt As Route In App.routes
		LogColor($"${rt.Method}: "${rt.Path}"->${rt.Class}"$, 0xFF0000FF)
	Next
	
	App.ssl.Enabled = True
	App.ssl.ShowLog = True
	App.ssl.SingleThread = False
	
	App.cors.Enabled = True
	App.cors.SingleThread = False
	App.cors.AllowedOrigin = "*"
	App.cors.AllowedMethods = "GET, OPTIONS"
	App.cors.AllowedHeaders = "Content-Type"
	
	App.AssetsFolderBrowsable = True
	App.AssetsFolder = File.Combine(File.DirApp, "assets")
	
	'App.smtp.ShowLog = True
	'App.smtp.Enabled = True
	'App.smtp.UseSsl = True
	'App.smtp.Port = 465
	
	'App.api.Name = "api"
	'App.api.EnableHelp = True
	
	'Log(TAB)
	'Log("Checking MethodAvailable for /api/*")
	'For Each Method As String In Array As String("GET", "POST", "PUT", "DELETE")
	'	If App.MethodAvailable(Method, "/api/*", "index") Then
	'		LogColor($"${Method}: Method available"$, 0xFF0000FF)
	'	Else
	'		LogColor($"${Method}: Method not available"$, 0xFFFF0000)
	'	End If
	'Next
	
	'' Checking if /api/ is consider as /api/*
	'Log(TAB)
	'Log("Checking MethodAvailable for /api/")
	'For Each Method As String In Array As String("GET", "POST", "PUT", "DELETE")
	'	If App.MethodAvailable(Method, "/api/", "Index") Then
	'		LogColor($"${Method}: Method available"$, 0xFF0000FF)
	'	Else
	'		LogColor($"${Method}: Method not available"$, 0xFFFF0000)
	'	End If
	'Next
	
	'' Checking if /api is consider as /api/*
	'Log(TAB)
	'Log("Checking MethodAvailable for /api")	
	'For Each Method As String In Array As String("GET", "POST", "PUT", "DELETE")
	'	If App.MethodAvailable(Method, "/api", "index") Then
	'		LogColor($"${Method}: Method available"$, 0xFF0000FF)
	'	Else
	'		LogColor($"${Method}: Method not available"$, 0xFFFF0000)
	'	End If
	'Next
	'App.LogStartupMessage 'optional
	App.ctx.Put("VERSION", VERSION)
	'Log($"App version: ${App.ctx.Get("VERSION")}"$)
	'Log("ctx=" & App.ctx)
	'Log("env=" & App.env)
	App.Start
	Log(App.StartupMessage)
	Log(App.ctx.Get("SERVER_URL"))
	StartMessageLoop
End Sub